{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "C:/Projects/Nivasa/backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000", "--app-dir", "C:/Projects/Nivasa/backend"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "backend-verify",
      "runtimeExecutable": "C:/Projects/Nivasa/backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8001", "--app-dir", "C:/Projects/Nivasa/backend"],
      "port": 8001
    },
    {
      "name": "frontend-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "env": { "VITE_DEV_API_TARGET": "http://127.0.0.1:8001" },
      "port": 5174
    }
  ]
}
